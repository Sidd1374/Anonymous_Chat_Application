rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - user can only access their own document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Notifications subcollection - user can read/write their own notifications
      match /notifications/{notificationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Devices subcollection - for FCM token management
      match /devices/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Matching pool - authenticated users can read, only owner can write
    match /matching_pool/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Chats collection - only participants can access
    match /chats/{chatId} {
      // Allow read if user is a participant
      allow read: if request.auth != null && 
        (resource.data.user1Id == request.auth.uid || 
         resource.data.user2Id == request.auth.uid);
      
      // Allow create if user is setting themselves as a participant
      allow create: if request.auth != null &&
        (request.resource.data.user1Id == request.auth.uid ||
         request.resource.data.user2Id == request.auth.uid);
      
      // Allow update if user is a participant
      allow update: if request.auth != null && 
        (resource.data.user1Id == request.auth.uid || 
         resource.data.user2Id == request.auth.uid);
      
      // Messages subcollection - participants can read/write
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Chat rooms (legacy/alternate) - only participants can access
    match /chatRooms/{chatId} {
      allow read, write: if request.auth != null && 
        (resource.data.user1Id == request.auth.uid || 
         resource.data.user2Id == request.auth.uid ||
         request.resource.data.user1Id == request.auth.uid ||
         request.resource.data.user2Id == request.auth.uid);
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Likes collection
    match /likes/{likeId} {
      allow read, write: if request.auth != null;
    }
    
    // Reports collection - users can create, only admins can read
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read: if false; // Admin SDK only
    }
  }
}
